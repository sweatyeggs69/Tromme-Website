# Pages are prerendered to dist/<route>/index.html and served at /<route>.
# wrangler.toml drop-trailing-slash redirects /<route>/; old .html addresses forward here.
/support.html /support 301
/status.html /status 301
/privacy.html /privacy 301
/terms.html /terms 301

# html_handling answers /page/ with a 307; make the move to /page a permanent 301.
# Keep this rule last.
/:page/ /:page 301
